# Normalize line endings: LF in repo, platform-native on checkout
* text=auto

# Always LF for these (cross-platform tooling)
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Windows-only scripts can use CRLF
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.woff2 binary
