# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# uv / virtualenv
.venv/
venv/
.uv/

# pytest
.pytest_cache/
.coverage
htmlcov/

# pyright / mypy
.pyright/
.mypy_cache/

# env / secrets — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem

# results and runs — commit only samples, not bulk outputs
runs/*.jsonl
results/*.json
!runs/samples/
!results/samples/

# cassettes — commit all (they are the reproducibility artefact)
# cassettes/ committed intentionally

# web
web/node_modules/
web/.next/
web/out/
web/dist/

# design tooling
design/node_modules/
design/trial/dist/
design/out/
# per-frame intermediates; the contact sheets, strips and mp4s built from them are committed
design/d4b/review*/frames/

# third-party papers kept locally for reading, not redistributed
/*.pdf

# OS
.DS_Store
Thumbs.db

# editors
.vscode/settings.json
.idea/
