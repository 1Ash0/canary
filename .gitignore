# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# uv / virtualenv
.venv/
venv/
.uv/

# pytest
.pytest_cache/
.coverage
htmlcov/

# pyright / mypy
.pyright/
.mypy_cache/

# env / secrets — NEVER commit these
.env
.env.*
*.key
*.pem

# results and runs — commit only samples, not bulk outputs
runs/*.jsonl
results/*.json
!runs/samples/
!results/samples/

# cassettes — commit all (they are the reproducibility artefact)
# cassettes/ committed intentionally

# web
web/node_modules/
web/.next/
web/out/

# OS
.DS_Store
Thumbs.db

# editors
.vscode/settings.json
.idea/
