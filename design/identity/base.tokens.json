{
  "$meta": {
    "name": "base",
    "status": "approved (owner, D2 gate, 2026-10-20): candidate B, warm dark",
    "units": "numbers are px unless noted; tracking is em; [min, max] sizes become clamp()"
  },
  "color": {
    "ground": "#121110",
    "surface": "#1A1816",
    "raised": "#23201C",
    "ink": "#F2EDE0",
    "ink2": "#ABA493",
    "ink3": "#77715F",
    "hairlineAlpha": 0.2,
    "accent": "#45AE9F",
    "loss": "#EE6240",
    "link": "#8FB4E8"
  },
  "font": {
    "sans": ["Instrument Sans", "system-ui", "sans-serif"],
    "mono": ["JetBrains Mono", "ui-monospace", "monospace"],
    "files": {
      "Instrument Sans": { "src": "fonts/instrument-sans-latin-wght-normal.woff2", "weight": "400 700" },
      "JetBrains Mono": { "src": "fonts/jetbrains-mono-latin-wght-normal.woff2", "weight": "100 800" }
    }
  },
  "type": {
    "display": { "family": "sans", "size": [42, 76], "weight": 500, "lineHeight": 1.02, "tracking": -0.025 },
    "h1":      { "family": "sans", "size": [34, 48], "weight": 500, "lineHeight": 1.1,  "tracking": -0.02 },
    "h2":      { "family": "sans", "size": [24, 30], "weight": 500, "lineHeight": 1.2,  "tracking": -0.01 },
    "body":    { "family": "sans", "size": 17, "weight": 400, "lineHeight": 1.55, "tracking": 0 },
    "small":   { "family": "sans", "size": 14, "weight": 400, "lineHeight": 1.5,  "tracking": 0 },
    "label":   { "family": "mono", "size": 12, "weight": 500, "lineHeight": 1.3,  "tracking": 0 },
    "data":    { "family": "mono", "size": 13, "weight": 400, "lineHeight": 1.35, "tracking": 0, "numeric": "tabular-nums" }
  },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "2xl": 48, "3xl": 64, "4xl": 96, "section": 160 },
  "radius": { "none": 0, "sm": 2, "md": 4, "pill": 999 },
  "line": { "hair": 1, "rule": 1.5, "mark": 2 },
  "layout": { "maxContent": 1120, "measure": "68ch", "gutter": 24, "columns": 12,
    "breakpoints": { "$note": "media queries cannot read CSS variables; site CSS repeats these literals with a comment", "md": 768, "lg": 1100 } },
  "motion": {
    "$note": "durations in ms; springs are closed-form (k = stiffness, d = damping); critical damping is d = 2*sqrt(k)",
    "duration": { "micro": 160, "base": 320, "slow": 700, "reveal": 900 },
    "ease": { "out": "cubic-bezier(0.22, 1, 0.36, 1)", "inOut": "cubic-bezier(0.65, 0, 0.35, 1)" },
    "stagger": { "lines": 80, "cells": 60 },
    "spring": {
      "step": { "k": 210, "d": 24, "use": "strata step arrivals; slight overshoot" },
      "seam": { "k": 90, "d": 19, "use": "the compaction seam; critically damped, hard stop" },
      "ui": { "k": 300, "d": 30, "use": "buttons, scrubber thumb, toggles" },
      "fall": { "k": 60, "d": 14, "use": "a gone marker leaving the frame" }
    }
  }
}
